FILES := main.cpp
BIN := http-server
LIBS := -lfmt
BUILD_DIR := build

CXX := g++
CXX_FLAGS := -std=c++17 -Wall -Werror -Wextra -Wpedantic

srcs := $(wildcard *.cpp)
objs := $(srcs:%.cpp=$(BUILD_DIR)/*.o)
asms := $(srcs:%.cpp=$(BUILD_DIR)/*.s)
deps := $(objs:%.o=.d) # dependencies

# run using all cores but not trully multithreaded
MAKEFLAGS += -j$(shell nproc)

.PHONY: run build asm clean

run : build
	@echo 🚀 [Executing]
	@echo -----------------------------------------
	@./$(BUILD_DIR)/$(BIN)

build : ./$(BUILD_DIR)/$(BIN)

asm : $(asms)# header dependency tracking (generated by -MMD)
-include $(deps)
# link : re-run only on file changes
$(BUILD_DIR)/$(BIN) : $(objs)
	@echo 🧩 [Linking]
	@echo -----------------------------------------
	@$(CXX) $^ -o $@ $(LIBS)

# compile: one .o per .cpp, rebuilt only if that .cpp (or its headers) changed
$(BUILD_DIR)/%.o: %.cpp
	@echo ⚙️ [Compiling] $<
	@echo -----------------------------------------
	@mkdir -p $(@D)
	@$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# assembly output
$(BUILD_DIR)/%.s: %.cpp
	@echo 📜 [Assembly] $<
	@echo -----------------------------------------
	@mkdir -p $(@D)
	@$(CXX) $(CXXFLAGS) -S $< -o $@

clean :
	@echo 🗑️ [Cleaning]
	@echo -----------------------------------------
	@rm -rf $(BUILD_DIR)
	@mkdir $(BUILD_DIR)

# header dependency tracking (generated by -MMD)
-include $(deps)
